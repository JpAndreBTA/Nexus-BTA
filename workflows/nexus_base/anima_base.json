{
  "nexus_bta_base": {
    "preset": "Anima",
    "activity": "txt2img",
    "description": "Nexus-owned Anima base workflow using the split diffusion model route: Anima diffusion model, Qwen text encoder, Qwen image VAE, CLIPTextEncode prompts and optional Concept LoRA."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "anima-base-v1.0.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Anima Diffusion Model"
    }
  },
  "2": {
    "class_type": "LoadQwen35AnimaCLIP",
    "inputs": {
      "clip_name": "anima2BQwen354BText_base.safetensors",
      "use_calibration": true,
      "use_alignment": true,
      "alignment_strength": 0.0,
      "output_scale": 1.0
    },
    "_meta": {
      "title": "Anima Qwen3.5 Text Encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "Anima Qwen Image VAE"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "anime character model sheet, full body, clean line art"
    },
    "_meta": {
      "title": "Anima Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "worst quality, low quality, score_1, score_2, score_3, blurry, jpeg artifacts, sepia, text, words, letters, captions, UI, interface, panels, boxes, document, chart, infographic, plain background, solid color background, flat background, black background, empty background, blank background, silhouette background, poster background, no scenery, isolated character"
    },
    "_meta": {
      "title": "Anima Negative Prompt"
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    },
    "_meta": {
      "title": "Anima Latent"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": -1,
      "steps": 20,
      "cfg": 4.0,
      "sampler_name": "er_sde",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "Anima Sampler"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Anima VAE Decode"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "NEXUS_BTA_ANIMA"
    },
    "_meta": {
      "title": "Save Anima Image"
    }
  }
}
